                  "value": {
                    "type": "string",
                    "pattern": "^[1-9][0-9]$$",
                    "description": "第几部或第几季的序号，从 1 开始，数字字符串形式。例如第二季传 \"2\"。拼接时由拼接层转为整数下发。"
                  }
                },
                "required": [
                  "field",
                  "value"
