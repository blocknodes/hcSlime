        "additionalProperties": false,
        "definitions": {
          "QueryNode": {
            "description": "查询节点，支持两种形态：1) 布尔复合节点（and/or/not）；2) 叶子条件节点（单个字段的匹配条件）。递归结构，布尔节点的子节点仍是 QueryNode。",
            "oneOf": [
              {
                "$$ref": "#/definitions/BoolNode"
              },
              {
                "$$ref": "#/definitions/LeafNode"
              }
            ]
          },
          "BoolNode": {
            "description": "布尔逻辑组合节点，支持 AND / OR / NOT 三种组合，可任意嵌套。三者互斥，一个节点只能带其中一个键。",
            "type": "object",
            "oneOf": [
              {
                "properties": {
                  "and": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                      "$$ref": "#/definitions/QueryNode"
                    },
                    "description": "AND 逻辑：所有子节点条件必须同时满足。拼接时每个子条件用括号包裹，子条件间用 AND 连接，如 (title:战狼) AND (title:战狼2)。"
                  }
                },
                "required": [
                  "and"
                ],
                "additionalProperties": false
              },
              {
                "properties": {
