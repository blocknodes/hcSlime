                        {
                          "const": "*"
                        }
                      ]
                    },
                    "to": {
                      "anyOf": [
                        {
                          "type": "string",
                          "pattern": "^(?:10(?:\\.0)?|[0-9](?:\\.[0-9])?)$$"
                        },
                        {
                          "const": "*"
                        }
                      ]
                    }
                  }
                }
              }
            ]
          },
