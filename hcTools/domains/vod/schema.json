                  }
                },
                "required": [
                  "field",
                  "value"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "field": {
                    "const": "voice_start_pos",
                    "description": "起播时间位置。"
                  },
                  "value": {
                    "type": "string",
                    "pattern": "^(0|[1-9][0-9]*)$",
                    "description": "起播位置(格式化取值)，单位为秒，非负整数字符串形式。例如第 10 分钟传 \"600\"，3 分 09 秒传 \"189\""
                  }
                },
                "required": [
                  "field",
                  "value"
                ],
                "additionalProperties": false
              }
            ]
          }
        }
      }
